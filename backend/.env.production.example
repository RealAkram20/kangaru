# =============================================================================
# KangaruRide — production environment template (W1-b)
# =============================================================================
#
# Copy the KEYS into Coolify's environment editor and set the values there.
# Do not commit a filled-in copy of this file: gitleaks runs on every push,
# and a real secret in git is a rotation, not a revert.
#
# Every value below is either SET (a decided default that is correct in
# production) or marked <<OWNER>> (a value only the owner or the deploy can
# provide). Nothing is left to a framework default that differs from what
# this platform needs — that is the whole point of this file, and four of the
# lines below exist because the default was silently wrong.
#
# `backend/.env.example` remains the LOCAL template and still works on XAMPP.
# One file cannot be both.
# -----------------------------------------------------------------------------


# --- Identity and debug ------------------------------------------------------

APP_NAME=KangaruRide
APP_ENV=production

# A stack trace rendered to a member of the public is a data leak: it carries
# file paths, query fragments and often the values that were being bound.
APP_DEBUG=false

# <<OWNER>> The public origin of the API, e.g. https://api.kangaruride.com
APP_URL=<<OWNER>>


# --- Keys --------------------------------------------------------------------

# <<OWNER>> Generate ONCE with `php artisan key:generate --show` and keep it
# stable forever.
#
# **Rotating this destroys data.** Driver identity documents and licences are
# encrypted at rest with it (ADR-0033), as is every user's `mfa_secret`. A new
# key does not fail loudly — the app boots, and every previously encrypted
# value becomes permanently unreadable. There is no recovery path and no
# backup restores it, because the ciphertext in the backup needs the old key
# too.
#
# If it ever MUST be rotated, the old key goes in APP_PREVIOUS_KEYS first and
# the payloads are re-encrypted before it is dropped.
APP_KEY=<<OWNER>>
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Cost factor for password hashing. 12 is the framework default and is a
# deliberate keep: raising it slows every sign-in on a server sized for
# dispatch, not for bcrypt.
BCRYPT_ROUNDS=12


# --- Web origins and CORS ----------------------------------------------------

# <<OWNER>> Where the console and the public site are served from.
FRONTEND_URL=<<OWNER>>

# Comma-separated, and NEVER `*`.
#
# `config/cors.php` did not exist before W1-b, so Laravel's default applied
# and that default is `allowed_origins => ['*']`. Falls back to FRONTEND_URL
# if unset; set it explicitly when the console and the public site are on
# different hosts.
#
# The driver app is unaffected by this: React Native sends no Origin and
# enforces no same-origin policy. Tightening CORS cannot break the handsets.
CORS_ALLOWED_ORIGINS=<<OWNER>>


# --- Database — its own container, never a shared server ---------------------

DB_CONNECTION=mysql

# <<OWNER>> The service name of THIS project's MySQL 8 container.
# master-plan.md §1 decision 4: dedicated, so a noisy neighbour cannot take
# down a bank client's dispatch and this project cannot take down theirs.
DB_HOST=<<OWNER>>
DB_PORT=3306
DB_DATABASE=<<OWNER>>

# <<OWNER>> NOT root. A least-privilege application user.
DB_USERNAME=<<OWNER>>
DB_PASSWORD=<<OWNER>>


# --- Redis — its own container, and it must actually be used -----------------

# <<OWNER>> The service name of THIS project's Redis container.
REDIS_CLIENT=phpredis
REDIS_HOST=<<OWNER>>
REDIS_PORT=6379
REDIS_PASSWORD=<<OWNER>>

# Namespaced so a shared instance could never collide. Belt and braces: the
# instance is meant to be dedicated.
REDIS_PREFIX=kangaruride_


# --- The two variables that decide whether Redis is used at all --------------
#
# **Both default to `database`, and that is the trap.** Provisioning the
# dedicated Redis the master plan requires and then leaving these unset gives
# a running Redis that nothing reads, while live positions and driver presence
# go to MySQL — precisely what ADR-0003 says must not happen. Nothing fails;
# the live map still draws, off the wrong store, and the growth risk ADR-0003
# was written about comes back.

TRACKING_LIVE_POSITIONS_DRIVER=redis
DISPATCH_PRESENCE_DRIVER=redis


# --- Cache, queue, session ---------------------------------------------------

CACHE_STORE=redis

# Database, deliberately, and not Redis. master-plan.md §3's process table
# names `QUEUE_CONNECTION=database` against the ADR-0003 GPS batch insert: a
# job that is durable across a Redis restart matters more here than queue
# throughput, because a lost batch is lost trip distance and therefore a wrong
# fare.
QUEUE_CONNECTION=database

# This is a token API (ADR-0022) and holds no server-side session for the SPA.
# The driver is `database` so nothing depends on Redis for a thing it does not
# use.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax


# --- Logging — and read this pair together -----------------------------------
#
# **`LOG_CHANNEL=stderr` silently disables structured logging.** The
# JSON formatter is a Monolog tap declared on the `stack` channel only
# (`config/logging.php` → `App\Logging\CustomizeLogger`). Pointing
# LOG_CHANNEL straight at `stderr` — which is what every Laravel-in-Docker
# guide says to do — bypasses the tap and emits plain text, losing the
# request_id / tenant_id / user_id / module context AGENTS.md Observability
# requires. Verified both ways on this branch.
#
# So: the channel stays `stack`, and the stack contains `stderr`.
LOG_CHANNEL=stack
LOG_STACK=stderr

# stderr, because a file inside a container does not survive a redeploy.
# Coolify captures the container's stream and that is what persists.
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null


# --- Error and performance tracking (ADR-0054) -------------------------------
#
# Sentry. Inert without a DSN, so leaving these unset is a supported state and
# is how a developer runs.
#
# <<OWNER>> The DSN from Sentry, Settings -> Projects -> <project> -> Client
# Keys (DSN). The host is what records the data region and it cannot be
# changed after the organisation is created:
#   ...ingest.de.sentry.io  -> EU (Frankfurt)   <- what was chosen
#   ...ingest.us.sentry.io  -> United States
# A DSN is a write-only credential for one project. It is not a secret in the
# sense APP_KEY is, but it is not public here either: put it in Coolify as a
# normal variable.
SENTRY_LARAVEL_DSN=<<OWNER>>

# Which environment an issue is filed under. Without this every deploy of
# every stage files into one bucket and "is this happening in production?"
# stops being answerable.
SENTRY_ENVIRONMENT=production

# **The owner's decision, recorded in ADR-0054 section 2.** On means a
# captured event carries the request body: passenger names, phone numbers,
# pickup and drop-off addresses. The scrubbed alternative was offered and
# refused.
#
# `docs/data-inventory.md` names Sentry as a processor because of this line,
# and the privacy notice discloses the transfer. If this is ever turned off,
# both of those want revisiting rather than leaving a disclosure that
# overstates what is sent.
#
# Credentials are scrubbed regardless — passwords, tokens, TOTP secrets,
# cookies and idempotency keys never leave the server. That is
# `App\Support\Observability\ScrubsSecrets`, it is not governed by this
# switch, and it has tests that fail if somebody widens it.
SENTRY_SEND_DEFAULT_PII=true

# Fraction of requests traced, 0 to 1. Tracing is billed per transaction.
# 0.1 is enough to characterise a slow endpoint; 1.0 is for a hunt, and is
# something to turn up briefly rather than to leave on.
SENTRY_TRACES_SAMPLE_RATE=0.1


# --- Files — driver documents need a volume that survives a redeploy ---------

# `local` writes inside the container. Driver identity documents (ADR-0033)
# are written here and are app-level encrypted; losing them on redeploy loses
# the compliance evidence the office reviewed. The path this disk points at
# MUST be a persistent volume (W1-a's to mount).
FILESYSTEM_DISK=local


# --- Mail --------------------------------------------------------------------

# <<OWNER>> `log` is the local default and would silently swallow every
# password reset and account-closure notice in production.
MAIL_MAILER=<<OWNER>>
MAIL_HOST=<<OWNER>>
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=<<OWNER>>
MAIL_PASSWORD=<<OWNER>>
MAIL_FROM_ADDRESS=<<OWNER>>
MAIL_FROM_NAME="${APP_NAME}"


# --- Tokens ------------------------------------------------------------------

# 1440 = 24 hours, one number for every role (ADR-0008).
#
# Lowering it is RETROACTIVE: Sanctum compares a token's created_at against
# this window rather than storing an expiry, so a smaller value signs out
# every older session the moment it deploys.
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440

# The SPA cookie mode is unused — the console sends bearer tokens. Left empty
# deliberately rather than inheriting Sanctum's localhost defaults into
# production.
SANCTUM_STATEFUL_DOMAINS=


# --- Retention (docs/data-inventory.md §6) -----------------------------------

# Raw GPS, in months. Enforced by `trip-locations:maintain`, which W1-b
# scheduled — it had been written and never run, so before this the stated
# retention happened on no schedule at all.
TRACKING_RETENTION_MONTHS=12

# Months of partitions carved ahead. If maintenance ever stops, rows fall into
# the `p_future` catch-all rather than erroring, so this failure is silent —
# which is why the scheduled command matters more than the number.
TRACKING_PARTITIONS_AHEAD=3

NOTIFICATION_RETENTION_DAYS=90


# --- Regional and money ------------------------------------------------------

MONEY_CURRENCY=UGX
MONEY_DEFAULT_ROUNDING=half_up
BILLING_TIMEZONE=Africa/Kampala
BILLING_INVOICE_PREFIX=INV
BILLING_CREDIT_NOTE_PREFIX=CRN


# =============================================================================
# NOT an environment variable, and the one that ends the platform if ignored
# =============================================================================
#
# **`DriverAppSeeder` must never run against this database.**
#
# It creates a demo driver, demo trips, and a Super Admin whose TOTP secret is
# a fixed literal committed to this repository. Seeding production hands
# anybody who has read the repo a working MFA second factor for an
# administrator account.
#
# The deploy command runs `php artisan migrate --force` and **nothing else**.
# It must not carry `--seed`, and `db:seed` must not appear in any release
# step, container entrypoint, or Coolify post-deploy hook. This is W1-a's to
# honour when the deploy script is written; it is stated here because this is
# the file that gets read while that script is being written.
#
# master-plan.md §5 gates go/no-go on it: "no seeder, no demo TOTP account in
# the live database".
