APP_NAME=KangaruRide
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kangaruride
DB_USERNAME=root
DB_PASSWORD=

# Redis is not required for local development yet — cache/session/queue below
# use the database driver. Redis becomes a hard dependency when GPS ingestion
# work starts (see docs/adr/0003-gps-ingestion-path.md).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# How long a Sanctum token stays valid, in minutes (ADR-0008). Default 1440
# — 24 hours, one number for every role. Lowering it is RETROACTIVE: Sanctum
# compares a token's created_at against this window rather than storing an
# expiry, so a smaller value signs out every older session at deploy.
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440

# Whether the second factor is in force (config/mfa.php, ADR-0008).
#
# On by default. Set it to false in a *development* .env so signing in as
# Finance or Super Admin — both seeded with a known TOTP secret — does not
# cost a hand-generated code on every reload. Nobody's secret is deleted.
#
# **Inert in production.** App\Support\Auth\MfaRequirement checks the
# environment before it reads this, so copying this file to a live server
# cannot disable the factor on the roles that move money.
MFA_ENABLED=true
