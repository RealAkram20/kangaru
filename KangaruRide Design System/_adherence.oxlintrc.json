        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, description, children, footer, onClose, width, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|warning|destructive)$/]",
        "message": "<Dialog> tone must be one of 'default' | 'warning' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|action|compact|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, action, compact, style."
