VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mapbox public token (pk.*) for the public order page map.
# Optional: without it the map falls back to an OpenStreetMap embed.
VITE_MAPBOX_TOKEN=

# Google OAuth client id (from Google Cloud Console) for the "fill in with
# Google" prefill on the order flow. Prefill only, not a sign-in — no
# customer accounts exist yet (ADR-0012). Optional: without it the button
# explains itself and the form works unchanged.
VITE_GOOGLE_CLIENT_ID=
