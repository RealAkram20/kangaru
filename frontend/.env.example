VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Maps JS API key — the primary map engine for the public order and
# ride screens. This is what gives Kampala's POIs, business names and
# landmarks; OpenStreetMap does not carry most of them upcountry.
#
# Needs a Google Cloud project with billing enabled and the "Maps
# JavaScript API" turned on. Restrict the key by HTTP referrer before it
# leaves a laptop — it ships in the client bundle and is world-readable.
#
# Optional: without it the map falls back to the engines below, so tests,
# CI and a fresh clone all still render a map.
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox public token (pk.*) for the fallback map and for geocoding.
# Optional. Without it, geocoding uses komoot's keyless Photon and the map
# uses MapLibre over CARTO Positron. Worth setting even alongside Google:
# the Mapbox geocoder filters to Uganda, which Photon does not, so local
# results stop being outranked by foreign ones.
VITE_MAPBOX_TOKEN=

# Google OAuth client id (from Google Cloud Console) for the "fill in with
# Google" prefill on the sign-up and log-in steps. Prefill only, not a
# sign-in: a real Google sign-in must verify the ID token server-side
# against Google's keys, which does not exist yet (ADR-0015). Optional —
# without it the button explains itself and the form works unchanged.
VITE_GOOGLE_CLIENT_ID=

# --- Error and performance tracking (ADR-0054) -------------------------------
#
# Optional. Without VITE_SENTRY_DSN the SDK is never initialised at all, which
# is how development and CI run.
#
# **Baked into the bundle at build time**, like VITE_API_BASE_URL - so setting
# it needs a rebuild, not a restart, and it is readable in devtools by anyone.
# That is normal for a browser DSN: it authorises writing events to one
# project and nothing else. Never reuse it as an auth token.
#
# The host records the data region and is fixed when the Sentry organisation
# is created: `...ingest.de.sentry.io` is the EU, `...ingest.us.sentry.io` the
# United States.
VITE_SENTRY_DSN=

# Defaults to Vite's MODE. Set it so a staging build cannot file its issues
# under `production`.
VITE_SENTRY_ENVIRONMENT=

# Fraction of page loads and navigations traced, 0 to 1. Defaults to 0.1;
# tracing is billed per transaction.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# The commit this bundle was built from. Match it to the backend's APP_BUILD
# and one issue can be followed across both halves of a request.
VITE_APP_BUILD=
