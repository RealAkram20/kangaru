# Environment for the CI run of the production compose file (W1-a).
#
# Every value here is a placeholder for a GitHub runner that is destroyed
# after the job. None is a secret, none is reused anywhere, and none of the
# real ones live in this repository — Coolify holds those. APP_KEY is
# generated fresh by the workflow and appended at run time.
APP_URL=http://localhost:18080
FRONTEND_URL=http://localhost:18081
CORS_ALLOWED_ORIGINS=http://localhost:18081
DB_DATABASE=kangaruride
DB_USERNAME=kangaruride
DB_PASSWORD=cipass
DB_ROOT_PASSWORD=ciroot
REDIS_PASSWORD=ciredis
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.test
VITE_API_BASE_URL=http://localhost:18080/api/v1
# Smaller than production defaults: the runner has 7 GB and 2 CPUs.
MYSQL_MEM=1024M
MYSQL_BUFFER_POOL=256M
APP_MEM=512M
